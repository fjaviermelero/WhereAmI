FROM python:3.11-slim

WORKDIR /app

# Instalar dbt y el adaptador de BigQuery
RUN pip install --no-cache-dir \
    dbt-core==1.12.5 \
    dbt-bigquery==1.12.1

# Copiar proyecto
COPY . .

# Instalar dependencias de dbt
RUN dbt deps

# Ejecutar dbt
ENTRYPOINT ["dbt"]
CMD ["build", "--profiles-dir", "/app"]