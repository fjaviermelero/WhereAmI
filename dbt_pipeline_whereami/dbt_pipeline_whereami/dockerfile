
FROM python:3.11-slim

WORKDIR /app

# Instalar Git
RUN apt-get update && \
    apt-get install -y --no-install-recommends git && \
    rm -rf /var/lib/apt/lists/*

# Instalar dbt y adaptador BigQuery
RUN pip install --no-cache-dir \
    dbt-core==1.12.5 \
    dbt-bigquery==1.12.1

# Copiar proyecto
COPY . .

# Instalar dependencias dbt
RUN dbt deps

ENTRYPOINT ["dbt"]
CMD ["build"]
